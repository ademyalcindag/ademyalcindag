{
  "expo": {
    "name": "Taşımacılık Rehberi",
    "slug": "tasimacilik-rehberi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tasimacilik.rehberi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#450ef3",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.tasimacilik.rehberi"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f98a72d5-df59-4404-af5a-212a35073f7f"
      }
    },
    "owner": "admylcndg"
  }
}
