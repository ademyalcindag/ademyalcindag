# Backend Configuration
PORT=3001
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-secret-key-min-32-chars
DB_PATH=./server.db

# Google OAuth Configuration
# Google Cloud Console https://console.cloud.google.com adresinde oluştur
# OAuth 2.0 Client ID'ni buraya yapıştır
GOOGLE_CLIENT_ID=703001786924-b09c4sm9kpsbpj8t9leallsunng4j9h1.apps.googleusercontent.com

# Frontend Configuration
# Production domain'ini buraya yaz (scheme ile beraber)
VITE_API_URL=https://www.senin-domainini.com
# Frontend Google OAuth istemci kimliği (web client ID)
VITE_GOOGLE_CLIENT_ID=703001786924-b09c4sm9kpsbpj8t9leallsunng4j9h1.apps.googleusercontent.com

# CORS Origins (virgülle ayır, boş bırakırsan tüm originlere izin verir)
# Hostinger'da aşağıdaki formatı kullan:
CORS_ORIGINS=https://www.senin-domainini.com,https://senin-domainini.com

# SMS Verification Provider
# Kullanici kaydinda SMS zorunlu degil
SMS_PROVIDER=disabled
SMS_DEFAULT_COUNTRY_CODE=+90

# Twilio ayarlari (SMS kullanmak istersen doldur)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# E-posta Aktivasyon Provider
# Production icin gercek saglayici kullan
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@senin-domainin.com
RESEND_API_KEY=

# Frontend App Base (normalde / bırak)
VITE_APP_BASE=/

# Punycode (xn--) hostta açılırsa yönlendirmek istediğin ASCII domain
# Örnek: www.tasimacilikrehberi.com
VITE_CANONICAL_HOST=
